{
  "shots": [
    {
      "id": "sh01-establish",
      "scene": "bridge",
      "holdSec": 8,
      "caption": "近地轨道站「聆汐」· 第 3041 天 · 夜班",
      "camera": {"from": {"x": 0.5, "y": 0.52, "zoom": 1.05}, "to": {"x": 0.5, "y": 0.5, "zoom": 1.18}},
      "transitionIn": "fade",
      "dialogue": [
        {"speaker": null, "text": "末日战争把天空打聋了。"},
        {"speaker": null, "text": "第三千零四十一天，聆汐还在轨道上听。"}
      ]
    },
    {
      "id": "sh02-console",
      "scene": "bridge",
      "holdSec": 7,
      "camera": {"from": {"x": 0.34, "y": 0.66, "zoom": 1.5}, "to": {"x": 0.35, "y": 0.65, "zoom": 1.7}},
      "dialogue": [
        {"speaker": null, "text": "值守台比凛的年纪还大。"},
        {"speaker": null, "text": "旋钮的漆磨出了金属原色，每一道都是前任留下的。"}
      ]
    },
    {
      "id": "sh03-mug",
      "scene": "bridge",
      "holdSec": 4.2,
      "camera": {"from": {"x": 0.35, "y": 0.62, "zoom": 1.6}, "to": {"x": 0.33, "y": 0.6, "zoom": 1.75}},
      "characters": [{"id": "rin", "x": 0.26, "y": 0.97, "scale": 0.85}],
      "props": [{"file": "tea-mug", "x": 0.42, "y": 0.7, "scale": 1.0, "anim": "none"}],
      "dialogue": [
        {"speaker": "rin", "text": "第三杯了。今晚的咖啡因额度也用完了。"}
      ]
    },
    {
      "id": "sh04-photo",
      "scene": "bridge",
      "holdSec": 4,
      "camera": {"from": {"x": 0.38, "y": 0.62, "zoom": 1.7}, "to": {"x": 0.37, "y": 0.61, "zoom": 1.85}},
      "characters": [{"id": "rin", "x": 0.3, "y": 0.97, "scale": 0.85}],
      "props": [{"file": "old-photo", "x": 0.46, "y": 0.68, "scale": 0.9, "anim": "none"}],
      "dialogue": [
        {"speaker": "rin", "text": "晚安。"}
      ]
    },
    {
      "id": "sh05-earth",
      "scene": "earth-window",
      "holdSec": 6.4,
      "camera": {"from": {"x": 0.5, "y": 0.55, "zoom": 1.15}, "to": {"x": 0.5, "y": 0.52, "zoom": 1.3}},
      "transitionIn": "fade",
      "dialogue": [
        {"speaker": null, "text": "窗外，地球的灯网比战前稀了大半。但还在亮，没有人去关灯。"}
      ]
    },
    {
      "id": "sh06-log",
      "scene": "bridge",
      "holdSec": 6,
      "camera": {"from": {"x": 0.36, "y": 0.6, "zoom": 1.45}, "to": {"x": 0.4, "y": 0.58, "zoom": 1.55}},
      "characters": [{"id": "rin", "x": 0.32, "y": 0.97, "scale": 0.8, "enter": "left"}],
      "props": [{"file": "tea-mug", "x": 0.22, "y": 0.7, "scale": 0.9, "anim": "none"}],
      "dialogue": [
        {"speaker": "rin", "text": "聆汐值班日志，第三千零四十一天。所有频段，依然安静。"}
      ]
    },
    {
      "id": "sh07-hum",
      "scene": "bridge",
      "holdSec": 9,
      "camera": {"from": {"x": 0.5, "y": 0.55, "zoom": 1.2}, "to": {"x": 0.5, "y": 0.53, "zoom": 1.3}},
      "dialogue": []
    },
    {
      "id": "sh08-ask",
      "scene": "bridge",
      "holdSec": 6,
      "camera": {"from": {"x": 0.5, "y": 0.52, "zoom": 1.9}},
      "characters": [{"id": "rin", "variant": "worried", "x": 0.5, "y": 0.98, "scale": 1.15}],
      "dialogue": [
        {"speaker": "rin", "text": "凯恩。你说，外面是不是已经没人记得我们了？"}
      ]
    },
    {
      "id": "sh09-kai",
      "scene": "bridge",
      "holdSec": 12.3,
      "camera": {"from": {"x": 0.6, "y": 0.5, "zoom": 1.5}, "to": {"x": 0.58, "y": 0.5, "zoom": 1.65}},
      "characters": [
        {"id": "kai", "x": 0.66, "y": 0.96, "scale": 0.9, "flip": true, "enter": "right"},
        {"id": "rin", "variant": "worried", "x": 0.28, "y": 0.97, "scale": 0.78, "flip": true}
      ],
      "dialogue": [
        {"speaker": "kai", "text": "记得与否不影响轨道力学。"},
        {"speaker": "kai", "text": "但你今晚的语频，比均值低了百分之十二。去睡一会儿，凛。"},
        {"speaker": "rin", "text": "睡了八年，不差这一晚。"}
      ]
    },
    {
      "id": "sh10-tea",
      "scene": "bridge",
      "holdSec": 6.5,
      "camera": {"from": {"x": 0.45, "y": 0.55, "zoom": 1.5}},
      "characters": [
        {"id": "kai", "x": 0.62, "y": 0.96, "scale": 0.85, "flip": true},
        {"id": "rin", "x": 0.3, "y": 0.97, "scale": 0.8}
      ],
      "props": [{"file": "tea-mug", "x": 0.38, "y": 0.7, "scale": 1.0, "anim": "none"}],
      "dialogue": [
        {"speaker": "kai", "text": "那我替你续上第三杯的配额。算不上安慰，只是热。"},
        {"speaker": "rin", "text": "谢了。"}
      ]
    },
    {
      "id": "sh11-window",
      "scene": "earth-window",
      "holdSec": 9,
      "camera": {"from": {"x": 0.5, "y": 0.55, "zoom": 1.25}, "to": {"x": 0.5, "y": 0.5, "zoom": 1.45}},
      "characters": [{"id": "rin", "x": 0.55, "y": 0.97, "scale": 1.0}],
      "props": [{"file": "tea-mug", "x": 0.68, "y": 0.9, "scale": 0.9, "anim": "none"}],
      "dialogue": [
        {"speaker": "rin", "text": "我在数灯。数到第三百盏就睡。"}
      ]
    },
    {
      "id": "sh12-pip",
      "scene": "bridge",
      "holdSec": 5.5,
      "camera": {"from": {"x": 0.55, "y": 0.5, "zoom": 1.35}, "to": {"x": 0.58, "y": 0.45, "zoom": 1.6}},
      "characters": [
        {"id": "kai", "x": 0.68, "y": 0.96, "scale": 0.85, "flip": true},
        {"id": "rin", "x": 0.3, "y": 0.97, "scale": 0.8}
      ],
      "props": [{"file": "signal-pip", "x": 0.72, "y": 0.35, "scale": 1.1, "anim": "blink-fast"}],
      "dialogue": [
        {"speaker": "kai", "text": "等一下。二百三十七频段——有东西应答了呼叫协议。"}
      ]
    },
    {
      "id": "sh13-lean",
      "scene": "bridge",
      "holdSec": 7,
      "camera": {"from": {"x": 0.65, "y": 0.45, "zoom": 1.9}, "to": {"x": 0.66, "y": 0.44, "zoom": 2.05}},
      "characters": [{"id": "rin", "x": 0.42, "y": 0.98, "scale": 1.0, "enter": "left"}],
      "props": [{"file": "signal-pip", "x": 0.66, "y": 0.36, "scale": 1.3, "anim": "blink-fast"}],
      "dialogue": []
    },
    {
      "id": "sh14-echo",
      "scene": "bridge",
      "holdSec": 9.6,
      "camera": {"from": {"x": 0.55, "y": 0.5, "zoom": 1.5}},
      "characters": [
        {"id": "kai", "x": 0.65, "y": 0.96, "scale": 0.9, "flip": true},
        {"id": "rin", "variant": "worried", "x": 0.3, "y": 0.97, "scale": 0.8}
      ],
      "props": [{"file": "signal-pip", "x": 0.72, "y": 0.35, "scale": 1.0, "anim": "blink"}],
      "dialogue": [
        {"speaker": "kai", "text": "正在比对接口协议。初步判定：回波。"},
        {"speaker": "kai", "text": "我们自己的呼叫，三个月前那轮，被什么弹了回来。"}
      ]
    },
    {
      "id": "sh15-isolate",
      "scene": "bridge",
      "holdSec": 4.8,
      "camera": {"from": {"x": 0.42, "y": 0.55, "zoom": 1.7}},
      "characters": [
        {"id": "rin", "variant": "worried", "x": 0.38, "y": 0.97, "scale": 0.9},
        {"id": "kai", "x": 0.7, "y": 0.96, "scale": 0.75, "flip": true}
      ],
      "props": [{"file": "signal-pip", "x": 0.72, "y": 0.35, "scale": 0.9, "anim": "blink"}],
      "dialogue": [
        {"speaker": "rin", "text": "把它单独隔离，增益拉满。"},
        {"speaker": "kai", "text": "已经是满的。"}
      ]
    },
    {
      "id": "sh16-check",
      "scene": "bridge",
      "holdSec": 6.9,
      "camera": {"from": {"x": 0.5, "y": 0.5, "zoom": 1.55}},
      "characters": [
        {"id": "rin", "variant": "worried", "x": 0.32, "y": 0.97, "scale": 0.85},
        {"id": "kai", "x": 0.66, "y": 0.96, "scale": 0.85, "flip": true}
      ],
      "props": [{"file": "signal-pip", "x": 0.72, "y": 0.35, "scale": 1.0, "anim": "blink"}],
      "dialogue": [
        {"speaker": "rin", "text": "能确定是回波吗？"},
        {"speaker": "kai", "text": "特征吻合度百分之九十七。是噪声，不是船。"}
      ]
    },
    {
      "id": "sh17-count",
      "scene": "bridge",
      "holdSec": 4.1,
      "camera": {"from": {"x": 0.5, "y": 0.55, "zoom": 1.4}, "to": {"x": 0.5, "y": 0.58, "zoom": 1.5}},
      "characters": [
        {"id": "rin", "variant": "worried", "x": 0.42, "y": 0.97, "scale": 0.95},
        {"id": "kai", "x": 0.68, "y": 0.96, "scale": 0.8, "flip": true}
      ],
      "props": [{"file": "signal-pip", "x": 0.2, "y": 0.36, "scale": 0.95, "anim": "blink"}],
      "dialogue": [
        {"speaker": "rin", "text": "第几次了？"},
        {"speaker": "kai", "text": "本季度第十四次虚警。"}
      ]
    },
    {
      "id": "sh18-linger",
      "scene": "bridge",
      "holdSec": 9,
      "camera": {"from": {"x": 0.5, "y": 0.5, "zoom": 1.35}},
      "characters": [{"id": "rin", "variant": "worried", "x": 0.45, "y": 0.97, "scale": 0.9}],
      "props": [{"file": "signal-pip", "x": 0.66, "y": 0.36, "scale": 1.05, "anim": "blink"}],
      "dialogue": []
    },
    {
      "id": "sh19-notecho",
      "scene": "bridge",
      "holdSec": 6.1,
      "camera": {"from": {"x": 0.58, "y": 0.48, "zoom": 1.7}},
      "characters": [
        {"id": "kai", "x": 0.62, "y": 0.96, "scale": 0.95, "flip": true},
        {"id": "rin", "variant": "worried", "x": 0.32, "y": 0.97, "scale": 0.78}
      ],
      "props": [{"file": "signal-pip", "x": 0.28, "y": 0.34, "scale": 0.95, "anim": "blink"}],
      "dialogue": [
        {"speaker": "kai", "text": "……不对。"},
        {"speaker": "kai", "text": "回波不会补全校验位。这个信号知道密钥。"}
      ]
    },
    {
      "id": "sh20-replay",
      "scene": "bridge",
      "holdSec": 5,
      "camera": {"from": {"x": 0.45, "y": 0.5, "zoom": 1.6}},
      "characters": [
        {"id": "rin", "variant": "worried", "x": 0.38, "y": 0.97, "scale": 0.9},
        {"id": "kai", "x": 0.68, "y": 0.96, "scale": 0.8, "flip": true}
      ],
      "props": [{"file": "signal-pip", "x": 0.22, "y": 0.36, "scale": 1.0, "anim": "blink"}],
      "dialogue": [
        {"speaker": "rin", "text": "回放确认位。"},
        {"speaker": "kai", "text": "第二遍了。它在等我们回答。"}
      ]
    },
    {
      "id": "sh21-freeze",
      "scene": "bridge",
      "holdSec": 7,
      "camera": {"from": {"x": 0.42, "y": 0.5, "zoom": 2.1}},
      "characters": [{"id": "rin", "variant": "worried", "x": 0.42, "y": 0.98, "scale": 1.2}],
      "props": [{"file": "signal-pip", "x": 0.62, "y": 0.4, "scale": 1.0, "anim": "blink"}],
      "dialogue": []
    },
    {
      "id": "sh22-corridor",
      "scene": "corridor",
      "holdSec": 10.2,
      "camera": {"from": {"x": 0.5, "y": 0.5, "zoom": 1.15}, "to": {"x": 0.5, "y": 0.5, "zoom": 1.35}, "ease": "linear"},
      "characters": [{"id": "rin", "variant": "worried", "x": 0.5, "y": 0.98, "scale": 1.05, "enter": "left"}],
      "transitionIn": "fade-black",
      "dialogue": [
        {"speaker": "rin", "text": "二百三十七——那是留给黎明号的频段。"},
        {"speaker": "kai", "text": "殖民船黎明号。登记状态：七年前失联，推定全员罹难。"}
      ]
    },
    {
      "id": "sh23-fb-depart",
      "scene": "dawn-flashback",
      "holdSec": 11,
      "caption": "七年前 · 黎明号",
      "camera": {"from": {"x": 0.5, "y": 0.5, "zoom": 1.1}, "to": {"x": 0.5, "y": 0.48, "zoom": 1.25}},
      "transitionIn": "fade-black",
      "dialogue": [
        {"speaker": null, "text": "黎明号，人类最后一艘殖民船。"},
        {"speaker": null, "text": "启航那天，四千零三十七人把名字写进了乘客名册。"}
      ]
    },
    {
      "id": "sh24-fb-last",
      "scene": "dawn-flashback",
      "holdSec": 10,
      "camera": {"from": {"x": 0.6, "y": 0.45, "zoom": 1.35}, "to": {"x": 0.58, "y": 0.45, "zoom": 1.5}},
      "dialogue": [
        {"speaker": null, "text": "七年前，它越过柯伊伯带，发回最后一条例行通报：一切正常。"}
      ]
    },
    {
      "id": "sh25-fb-silence",
      "scene": "dawn-flashback",
      "holdSec": 8,
      "camera": {"from": {"x": 0.5, "y": 0.5, "zoom": 1.2}, "to": {"x": 0.48, "y": 0.5, "zoom": 1.35}},
      "dialogue": [
        {"speaker": null, "text": "此后静默。搜救令在第二年终止，聆汐呼叫了它七年。"}
      ]
    },
    {
      "id": "sh26-fb-drift",
      "scene": "dawn-flashback",
      "holdSec": 9,
      "camera": {"from": {"x": 0.45, "y": 0.5, "zoom": 1.15}, "to": {"x": 0.44, "y": 0.5, "zoom": 1.3}},
      "dialogue": []
    },
    {
      "id": "sh27-verify",
      "scene": "bridge",
      "holdSec": 6.5,
      "camera": {"from": {"x": 0.55, "y": 0.5, "zoom": 1.6}},
      "characters": [
        {"id": "kai", "x": 0.65, "y": 0.96, "scale": 0.9, "flip": true},
        {"id": "rin", "variant": "determined", "x": 0.3, "y": 0.97, "scale": 0.8}
      ],
      "props": [{"file": "signal-pip", "x": 0.72, "y": 0.35, "scale": 1.0, "anim": "blink"}],
      "transitionIn": "fade-black",
      "dialogue": [
        {"speaker": "kai", "text": "身份校验——通过。密钥签发早于封存令。"},
        {"speaker": "rin", "text": "让它再说一遍。"}
      ]
    },
    {
      "id": "sh28-breath",
      "scene": "bridge",
      "holdSec": 7,
      "camera": {"from": {"x": 0.5, "y": 0.5, "zoom": 1.4}},
      "characters": [
        {"id": "rin", "variant": "determined", "x": 0.42, "y": 0.97, "scale": 0.9},
        {"id": "kai", "x": 0.66, "y": 0.96, "scale": 0.8, "flip": true}
      ],
      "props": [{"file": "signal-pip", "x": 0.7, "y": 0.35, "scale": 1.0, "anim": "blink"}],
      "dialogue": []
    },
    {
      "id": "sh29-dock",
      "scene": "dock",
      "holdSec": 10,
      "caption": "聆汐 · 船坞外",
      "camera": {"from": {"x": 0.55, "y": 0.45, "zoom": 1.2}, "to": {"x": 0.6, "y": 0.42, "zoom": 1.4}},
      "transitionIn": "fade-black",
      "dialogue": [
        {"speaker": null, "text": "「黎明号，请求返港。」"}
      ]
    },
    {
      "id": "sh30-order",
      "scene": "bridge",
      "holdSec": 10.3,
      "camera": {"from": {"x": 0.48, "y": 0.52, "zoom": 1.9}, "to": {"x": 0.5, "y": 0.5, "zoom": 2.0}},
      "characters": [
        {"id": "rin", "variant": "determined", "x": 0.48, "y": 0.98, "scale": 1.15},
        {"id": "kai", "x": 0.7, "y": 0.96, "scale": 0.75, "flip": true}
      ],
      "transitionIn": "cut",
      "dialogue": [
        {"speaker": "kai", "text": "按规程，未识别的归航舰只应该先隔离审查。"},
        {"speaker": "rin", "text": "规程，是写给还有人的世界的。"},
        {"speaker": "rin", "text": "打开三号泊位。"}
      ]
    },
    {
      "id": "sh31-bridgehold",
      "scene": "bridge",
      "holdSec": 7,
      "camera": {"from": {"x": 0.5, "y": 0.5, "zoom": 1.3}},
      "characters": [{"id": "rin", "variant": "determined", "x": 0.5, "y": 0.98, "scale": 1.05}],
      "dialogue": []
    },
    {
      "id": "sh32-ring",
      "scene": "dock",
      "holdSec": 13,
      "camera": {"from": {"x": 0.5, "y": 0.45, "zoom": 1.5}, "to": {"x": 0.5, "y": 0.44, "zoom": 1.7}},
      "transitionIn": "fade-black",
      "dialogue": []
    },
    {
      "id": "sh33-title",
      "scene": null,
      "holdSec": 7,
      "caption": "第一集 · 静默信标",
      "transitionIn": "fade-black",
      "dialogue": []
    }
  ]
}
